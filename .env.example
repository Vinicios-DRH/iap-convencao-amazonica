# Copie pra .env e preencha com os valores reais. Esse arquivo (.env.example)
# não tem segredo nenhum, só documenta quais variáveis o projeto precisa.

# Banco de dados (Postgres — Supabase). Localmente, se a conexão direta
# (db.<projeto>.supabase.co) não resolver, use a connection string do
# "Transaction pooler" no painel do Supabase (Project Settings > Database).
DATABASE_URL=postgresql+psycopg://usuario:senha@host:porta/banco

SUPABASE_DB_URL=
SUPABASE_KEY=

# Flask
SECRET_KEY=

# Backblaze B2 (upload de arquivos/imagens)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# Regras de lote/preço da inscrição
LOT1_LIMIT=50
LOT1_PRICE=180.09
LOT2_PRICE=200.09
PIX_SUFFIX=0.09

# Legado, não usado hoje (ver conversa sobre inscricoes_status via AppSetting)
DB_MODE=
INSCRICOES_SUSPENSAS=0
